GROQ_API_KEY=your_groq_key
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
JINA_API_KEY=your_jina_key
JINA_EMBEDDING_MODEL=jina-embeddings-v2-base-en
CHUNK_SIZE=1500
CHUNK_OVERLAP=250
# you can also use a local Qdrant instance by setting 
# the URL to http://localhost:6333 
# after running `docker run -p 6333:6333 qdrant/qdrant`
# and leave the API key blank
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=notebooklm
PORT=3000
